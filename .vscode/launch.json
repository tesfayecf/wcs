{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NextJS dev turbo",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "restart": true,
      "env": {
        "NODE_ENV": "development"
      },
      "runtimeArgs": ["run", "dev::next::turbo", "--inspect"],
      "console": "integratedTerminal"
    },
    {
      "name": "NextJS dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "restart": true,
      "env": {
        "NODE_ENV": "development"
      },
      "runtimeArgs": ["run-script", "dev::next", "--inspect"],
      "console": "integratedTerminal"
    },
    {
      "name": "Django WSGI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver"],
      "django": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Django ASGI Daphne",
      "type": "debugpy",
      "request": "launch",
      "module": "daphne",
      "cwd": "${workspaceFolder}/backend",
      "args": ["backend.asgi:application"],
      "django": true
    },
    {
      "name": "NextJS prod",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "restart": true,
      "runtimeArgs": ["run-script", "dev::start"],
      "console": "integratedTerminal"
    },
    {
      "name": "Django prod",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver"],
      "django": true,
      "console": "integratedTerminal"
    },
    {
      "name": "web-renderer",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend",
      "timeout": 10000,
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "APP dev",
      "configurations": ["Django WSGI", "NextJS dev"]
    },
    {
      "name": "APP dev - web",
      "configurations": ["Django WSGI", "NextJS dev", "web-renderer"]
    },
    {
      "name": "APP prod",
      "configurations": ["NextJS prod", "Django prod"]
    }
  ]
}
