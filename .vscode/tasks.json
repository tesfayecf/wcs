{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch all",
      "dependsOn": [],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "NextJS: --watch ts",
      "type": "shell",
      "command": "npm",
      "group": {
        "kind": "build"
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "args": ["run", "ts:watch"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "NextJS: --watch lint",
      "type": "shell",
      "command": "npm",
      "group": {
        "kind": "build"
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "args": ["run", "lint"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start EMQ X Broker",
      "type": "shell",
      "command": "C:\\emqx\\bin\\emqx.cmd",
      "args": ["start"],
      "options": {
        "cwd": "C:\\emqx\\bin"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop EMQ X Broker",
      "type": "shell",
      "command": "C:\\emqx\\bin\\emqx.cmd",
      "args": ["stop"],
      "options": {
        "cwd": "C:\\emqx\\bin"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}
