{
  "version": "0.2.0",
  "configurations": [
    ////////////////////////
    /// Django - Backend ///
    ////////////////////////
    {
      "name": "🐍 Django Development",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "--nothreading"],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DJANGO_DEBUG": "True",
        "DJANGO_SETTINGS_MODULE": "backend.settings",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Django - Backend",
        "order": 1
      }
    },
    {
      "name": "🔌 Django ASGI (Daphne)",
      "type": "debugpy",
      "request": "launch",
      "module": "daphne",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "-b", "0.0.0.0",
        "-p", "8000",
        "backend.asgi:application"
      ],
      "django": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DJANGO_DEBUG": "True",
        "DJANGO_SETTINGS_MODULE": "backend.settings",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Django - Backend",
        "order": 2
      }
    },
    {
      "name": "🎯 Django Production",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "--noreload", "--nothreading"],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DJANGO_DEBUG": "False",
        "DJANGO_SETTINGS_MODULE": "backend.settings",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Django - Backend",
        "order": 3
      }
    },

    /////////////////////////
    /// Django - Database ///
    /////////////////////////
    // Reset
    {
      "name": "🗄️ Database: Reset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/create_database.py",
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database Management",
        "order": 1
      }
    },

    // Migrate
    {
      "name": "🔄 Database: Migrate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["migrate"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database Management",
        "order": 2
      }
    },

    // Database Clear Commands
    {
      "name": "🧹 Clear: Users",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["clear_users_data"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database - Clear",
        "order": 3
      }
    },
    {
      "name": "🧹 Clear: Resources",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["clear_resources_data"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database - Clear",
        "order": 4
      }
    },
    {
      "name": "🧹 Clear: Timeseries",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["clear_timeseries_data"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database - Clear",
        "order": 5
      }
    },

    // Create
    {
      "name": "📝 Create: Users",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["create_users_data"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database - Create",
        "order": 6
      }
    },
    {
      "name": "📝 Create: Resources",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["create_resources_data"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database - Create",
        "order": 7
      }
    },
    {
      "name": "📝 Create: Timeseries",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["create_timeseries_data"],
      "django": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "hidden": false,
        "group": "Database - Create",
        "order": 8
      }
    }
  ],
  "compounds": [
    {
      "name": "🧹 Clear All Data",
      "configurations": [
        "🧹 Clear: Users",
        "🧹 Clear: Resources",
        "🧹 Clear: Timeseries"
      ],
      "stopAll": true,
      "presentation": {
        "group": "database",
        "order": 1
      }
    },
    {
      "name": "📝 Create All Data",
      "configurations": [
        "📝 Create: Users",
        "📝 Create: Resources",
        "📝 Create: Timeseries"
      ],
      "stopAll": true,
      "presentation": {
        "group": "database",
        "order": 2
      }
    }
  ]
}
