{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NextJS:build --turbo",
      "type": "shell",
      "command": "npm",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "args": ["run", "turbo:next"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Daphne",
      "type": "shell",
      "command": "daphne",
      "args": ["backend.asgi:application"],
      "options": {
        "cwd": "${workspaceFolder/backend}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start EMQ X Broker",
      "type": "shell",
      "command": "C:\\emqx\\bin\\emqx.cmd",
      "args": ["start"],
      "options": {
        "cwd": "C:\\emqx\\bin"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop EMQ X Broker",
      "type": "shell",
      "command": "C:\\emqx\\bin\\emqx.cmd",
      "args": ["stop"],
      "options": {
        "cwd": "C:\\emqx\\bin"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}
