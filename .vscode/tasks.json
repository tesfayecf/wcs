{
  "version": "2.0.0",
  "tasks": [
    ///////////////////////////////
    /// TypeScript Generation  ///
    ///////////////////////////////
    {
      "label": "🔄 Generate APITypeScript Types (Watch Mode)",
      "type": "shell",
      "command": "nodemon",
      "args": [
        "--exec", "python", "C:/Users/tesfa/Documents/Programming/WCS/Code/src/backend/manage.py", "generate_ts",
        "--all", "--trim", "--enum_choices",
        "-o", "C:/Users/tesfa/Documents/Programming/WCS/Code/src/frontend/app/lib/api/types",
        "--watch", "C:/Users/tesfa/Documents/Programming/WCS/Code/src/backend"
      ],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "detail": "Run Django management command to generate TypeScript types in watch mode"
    },

    ///////////////////
    /// SCSS Build  ///
    ///////////////////
    {
      "label": "🎨 Compile SCSS",
      "type": "shell",
      "command": "sass",
      "args": [
        "styles:public",
        "--watch"
      ],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Compile SCSS files in watch mode"
    }
  ]
}
