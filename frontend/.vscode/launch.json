{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run NextJS dev",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "restart": true,
            "env": {
                "NODE_ENV": "development"
            },
            "runtimeArgs": [
                "run-script",
                "dev"
            ],
            "console": "integratedTerminal"
        }
    ]
}