{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All",
      "dependsOn": [
        "🎨 Compile SCSS",
        "🔄 Generate APITypeScript Types",
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true
    },

    ///////////////////////////////
    /// TypeScript Generation  ///
    ///////////////////////////////
    {
      "label": "🔄 Generate APITypeScript Types",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "linux": {
        "command": "watch",
        "args": [
          "-n",
          "1",
          "python",
          "./manage.py",
          "generate_ts",
          "--all",
          "--trim",
          "--enum_choices",
          "-o",
          "${workspaceFolder}/frontend/app/lib/api/types"
        ],
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "while($true) { python 'manage.py' generate_ts --all --trim --enum_choices -o '${workspaceFolder}/frontend/app/lib/api/types'; Start-Sleep -Seconds 2 }"
        ]
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "detail": "Run Django management command to generate TypeScript types in watch mode using watch"
    },

    ///////////////////
    /// SCSS Build  ///
    ///////////////////
    {
      "label": "🎨 Compile SCSS",
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "command": "npx",
      "args": [
        "sass",
        "styles/app.scss:styles/app.css",
        "--watch"
      ],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "detail": "Compile SCSS files in watch mode"
    }
  ]
}
